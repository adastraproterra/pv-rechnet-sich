---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const eintraege = await getCollection("artikel");
  return eintraege.map((e) => ({ params: { slug: e.id }, props: { e } }));
}

const { e } = Astro.props;
const { Content } = await render(e);
const site = "https://DEINE-DOMAIN.de"\;
---
<BaseLayout title={e.data.title} description={e.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": e.data.title,
    "datePublished": e.data.datePublished,
    "dateModified": e.data.dateModified,
    "author": { "@id": `${site}/#person` },
    "publisher": { "@id": `${site}/#org` },
    "about": e.data.about,
    "mainEntityOfPage": `${site}/artikel/${e.id}/`
  })} />
  <article>
    <h1>{e.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
